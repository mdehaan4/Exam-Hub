{
  "rules": {
    "games": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() && newData.child('players/w').exists() && !newData.child('players/b').exists() && !newData.child('moves').exists()",
        ".validate": "$code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789][ABCDEFGHJKLMNPQRSTUVWXYZ23456789][ABCDEFGHJKLMNPQRSTUVWXYZ23456789][ABCDEFGHJKLMNPQRSTUVWXYZ23456789][ABCDEFGHJKLMNPQRSTUVWXYZ23456789][ABCDEFGHJKLMNPQRSTUVWXYZ23456789]$/) && newData.hasChildren(['players', 'createdAt'])",
        "players": {
          "w": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "b": {
            ".write": "!data.exists() && newData.exists() && newData.val() !== data.parent().child('w').val()",
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "$other": {
            ".validate": false
          }
        },
        "moves": {
          "$n": {
            ".write": "!data.exists() && newData.exists() && $n.matches(/^[0-9]+$/) && $n.length <= 4 && ($n === '0' || !$n.beginsWith('0')) && root.child('games/' + $code + '/players/b').exists()",
            ".validate": "(newData.hasChildren(['from', 'to']) && !newData.child('pass').exists()) || (newData.child('pass').exists() && !newData.child('from').exists() && !newData.child('to').exists() && !newData.child('promotion').exists())",
            "pass": {
              ".validate": "newData.val() === true"
            },
            "from": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-h][1-8]$/)"
            },
            "to": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-h][1-8]$/) && newData.val() !== newData.parent().child('from').val()"
            },
            "promotion": {
              ".validate": "newData.isString() && newData.val().matches(/^[QRBN]$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]+$/) && newData.val().length <= 32"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
