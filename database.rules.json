{
  "rules": {
    "games": {
      "$code": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.child('players/w').val() === auth.uid && !newData.child('players/b').exists() && !newData.child('moves').exists()",
        ".validate": "$code.matches(/^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/) && newData.hasChildren(['players', 'createdAt'])",
        "players": {
          "w": {
            ".validate": "newData.isString()"
          },
          "b": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('w').val() !== auth.uid",
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "moves": {
          "$n": {
            ".write": "auth != null && !data.exists() && newData.exists() && $n === data.parent().numChildren() + '' && root.child('games/' + $code + '/players/b').exists() && (($n.matches(/[02468]$/) && root.child('games/' + $code + '/players/w').val() === auth.uid) || ($n.matches(/[13579]$/) && root.child('games/' + $code + '/players/b').val() === auth.uid))",
            ".validate": "newData.hasChildren(['from', 'to'])",
            "from": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-h][1-8]$/)"
            },
            "to": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-h][1-8]$/) && newData.val() !== newData.parent().child('from').val()"
            },
            "promotion": {
              ".validate": "newData.isString() && newData.val().matches(/^[QRBN]$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
